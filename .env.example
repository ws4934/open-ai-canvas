# 本文件只声明可公开的配置，不要提交真实密码或密钥。
# 复制为 .env 后执行 openssl rand -hex 32，将输出填入 POSTGRES_PASSWORD；留空无法启动。
POSTGRES_DB=open_ai_canvas
POSTGRES_USER=open_ai_canvas
POSTGRES_PASSWORD=
# Compose 自动把上述值同时传给 PostgreSQL 和应用，无需另填 DATABASE_URL 或 PG*。
CANVAS_REGISTRATION_ENABLED=false
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
# 业务 API 的跨域来源白名单；公开前端静态文件和 SPA 页面不受此项限制。
CANVAS_CORS_ORIGINS=http://localhost:3000
CANVAS_PUBLIC_BASE_URL=
# 仅填写实际反向代理的源 IP/CIDR；留空不信任转发头。
CANVAS_TRUSTED_PROXIES=
# 留空使用项目隔离的 Docker named volume；可显式填写持久化目录。
CANVAS_DATA_PATH=
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
CANVAS_AGENT_MAX_PROCESSES=30
CANVAS_AGENT_NODE_MEMORY_MB=512
CANVAS_SHUTDOWN_TIMEOUT=10m
CANVAS_AUTO_MIGRATE=true
CANVAS_WHISPER_BASE_URL=
CANVAS_FFMPEG_PATH=
# 单应用镜像内已包含 Node；网页更新替换此持久目录里的 Go 程序。
CANVAS_MANAGED_BINARY_PATH=/data/system/bin/yingce-backend
# 新服务器由 install-server-image.sh 生成以下配置；镜像版本用于首次初始化。
# CANVAS_IMAGE_TAG=具体 Release（不带 v）
# CANVAS_IMAGE=ghcr.io/ws4934/open-ai-canvas:具体版本
# CANVAS_HTTP_BIND=127.0.0.1
# CANVAS_HTTP_PORT=3000
# CANVAS_POSTGRES_DATA_PATH=./postgres-data
# CANVAS_REDIS_DATA_PATH=./redis-data
# CANVAS_LOG_LEVEL=info
# CANVAS_LOG_FORMAT=text
